# ── Supabase ──────────────────────────────────────────────
# Public (safe in the browser; RLS protects every table)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — discovery agent writes the job catalog with this key.
# Dashboard → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...

# ── AI (job analysis, cover letters, FRIDAY chat, AI resume editor) — all optional ──
# Set any of these free keys; FRIDAY auto-detects them. With none, FRIDAY Local + the local resume
# engine, ATS scoring, job matching and grammar cleanup still work.
#   NVIDIA (build.nvidia.com, free): https://build.nvidia.com  → any model page → "Get API Key" (nvapi-…)
#   Groq (free tier):                https://console.groq.com/keys
#   Google Gemini (free):            https://aistudio.google.com/apikey
#   OpenRouter (:free models):       https://openrouter.ai/keys
#   Ollama (local, no key):          AI_PROVIDER=ollama
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# AI_PROVIDER=nvidia|groq|gemini|openrouter|ollama   AI_MODEL=...   (or AI_BASE_URL + AI_API_KEY for any OpenAI-compatible server)

# Per-task models (src/lib/ai/routing.ts has the defaults). Format: provider[:model],provider[:model],…
# The first configured entry is tried first; failures fall through to the next, then to any other provider.
#   resume_rewrite  resume_analysis  ats_analysis  job_matching  semantic_search (embeddings)  document_parsing
# AI_TASK_RESUME_REWRITE=nvidia:moonshotai/kimi-k2.6,gemini,groq
# AI_TASK_JOB_MATCHING=nvidia:nvidia/nemotron-3-super-120b-a12b,gemini
# AI_TASK_SEMANTIC_SEARCH=nvidia:nvidia/nemotron-3-embed-1b
# AI_EMBED_MIN_SIM=0.4        # minimum embedding similarity for a "related evidence" hit (calibrated on nemotron-3-embed-1b: related ≈0.55, unrelated ≤0.25)

# ── Agent schedule ────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/agent/cron.
CRON_SECRET=

# Public site URL (auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Federal internships (optional) — USAJOBS official API ─
# Free key: https://developer.usajobs.gov/APIRequest/Index — the User-Agent must be the email you registered with.
# Without both, the source is skipped and Settings says so; nothing is faked.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# ── Email alerts (optional) — Resend ──────────────────────
# Without both, no email is sent and Settings says so. EMAIL_FROM must be a sender on a domain verified in Resend.
# Alerts respect each student's preferences, are de-duplicated, capped at 5 per student per 24h, and logged to email_log.
RESEND_API_KEY=
EMAIL_FROM=FRIDAY <alerts@your-domain.com>

# ── Signing secret (optional) ─────────────────────────────
# Signs AI-written resume lines and email unsubscribe links. Falls back to SUPABASE_SECRET_KEY when unset.
AI_SIGNING_SECRET=

# ── Adzuna job search (optional) — https://developer.adzuna.com ──
# Free key. Server-side only; never exposed to the browser. Without both, Adzuna is skipped and Settings says so.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# ADZUNA_MAX_REQUESTS=8   # cap on API calls per sync (default 8, max 40)
