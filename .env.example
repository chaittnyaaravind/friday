# ── Supabase ──────────────────────────────────────────────
# Public (safe in the browser; RLS protects every table)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — discovery agent writes the job catalog with this key.
# Dashboard → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Claude (resume parsing, requirement extraction, tailoring, FRIDAY chat) ──
ANTHROPIC_API_KEY=

# ── Agent schedule ────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/agent/cron.
CRON_SECRET=

# Public site URL (auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
